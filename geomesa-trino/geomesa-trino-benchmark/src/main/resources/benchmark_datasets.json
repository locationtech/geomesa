{
  "_comment": "Dataset configurations for TrinoBenchmarkRunner. CQL strings can reference WKT constants from the 'geometries' block via ${NAME} substitution — keeps the bigger polygons out of every filter row and gives them stable names. Adding or tuning a dataset is a JSON edit; no code change needed.",

  "geometries": {
    "_comment":       "Single source of truth for benchmark WKTs — tools/benchmark.py loads this block too (guarded by tools/tests/test_benchmark_geometries.py).",
    "NE_US":          "POLYGON ((-80 37, -70 37, -70 45, -80 45, -80 37))",
    "NE_US_10X10":    "POLYGON ((-80 35, -70 35, -70 45, -80 45, -80 35))",
    "SMALL_BOX":      "POLYGON ((-78 38, -76 38, -76 40, -78 40, -78 38))",
    "DC_PT":          "POINT (-77.0369 38.9072)",
    "BJ_LARGE":       "POLYGON ((116.0 39.6, 117.0 39.6, 117.0 40.2, 116.0 40.2, 116.0 39.6))",
    "BJ_TIGHT":       "POLYGON ((116.39 39.91, 116.41 39.91, 116.41 39.93, 116.39 39.93, 116.39 39.91))",
    "BJ_PEK":         "POLYGON ((116.57 40.07, 116.61 40.07, 116.61 40.10, 116.57 40.10, 116.57 40.07))",
    "TIANANMEN":      "POINT (116.3912 39.9075)",
    "GL_LARGE":       "POLYGON ((116.0 39.5, 117.5 39.5, 117.5 40.5, 116.0 40.5, 116.0 39.5))",
    "GL_MEDIUM":      "POLYGON ((116.35 39.88, 116.45 39.88, 116.45 39.95, 116.35 39.95, 116.35 39.88))",
    "GL_SMALL":       "POLYGON ((116.3 39.8, 116.6 39.8, 116.6 40.0, 116.3 40.0, 116.3 39.8))",
    "AIS_LARGE":      "POLYGON ((-84 24, -78 24, -78 34, -84 34, -84 24))",
    "AIS_MEDIUM":     "POLYGON ((-80.2 32.3, -79.6 32.3, -79.6 33.0, -80.2 33.0, -80.2 32.3))",
    "AIS_PE_TIGHT":   "POLYGON ((-80.12 26.09, -80.10 26.09, -80.10 26.11, -80.12 26.11, -80.12 26.09))",
    "AIS_MIAMI":      "POLYGON ((-80.15 25.77, -80.11 25.77, -80.11 25.81, -80.15 25.81, -80.15 25.77))",
    "PORT_EVERGLADES": "POINT (-80.11 26.10)"
  },

  "datasets": [
    {
      "table": "observations",
      "label": "Synthetic CONUS observations",
      "filters": [
        {"label": "Unfiltered",                                          "cql": "INCLUDE"},
        {"label": "BBOX",                                                "cql": "BBOX(geom,-80,37,-70,45)"},
        {"label": "INTERSECTS large (NE-US polygon)",                    "cql": "INTERSECTS(geom, ${NE_US})"},
        {"label": "INTERSECTS small (2°×2° DC box)",                     "cql": "INTERSECTS(geom, ${SMALL_BOX})"},
        {"label": "WITHIN large",                                        "cql": "WITHIN(geom, ${NE_US})"},
        {"label": "DWITHIN 100 km DC",                                   "cql": "DWITHIN(geom, ${DC_PT}, 100000, meters)"},
        {"label": "DURING 2023",                                         "cql": "dtg DURING 2023-01-01T00:00:00Z/2024-01-01T00:00:00Z"},
        {"label": "INTERSECTS large AND DURING 2023",                    "cql": "INTERSECTS(geom, ${NE_US}) AND dtg DURING 2023-01-01T00:00:00Z/2024-01-01T00:00:00Z"},
        {"label": "active=TRUE AND value>50 AND INTERSECTS large",       "cql": "active = TRUE AND value > 50.0 AND INTERSECTS(geom, ${NE_US})"},
        {"label": "[smoke] read INTERSECTS small as features",           "cql": "INTERSECTS(geom, ${SMALL_BOX})", "featuresOnly": true}
      ]
    },

    {
      "_comment": "Synthetic CONUS regions — POLYGON geom, XZ2-partitioned (truncate 13). Same CONUS extent + 2023/2024 dtg as observations; exercises the XZ2 spatial-index path (vs observations' Z2 point path). The tight SMALL_BOX intersect is where SI's xz2 pruning should beat the plain iceberg catalog.",
      "table": "regions",
      "label": "Synthetic CONUS regions (polygons, XZ2)",
      "filters": [
        {"label": "Unfiltered",                                          "cql": "INCLUDE"},
        {"label": "BBOX (NE-US)",                                        "cql": "BBOX(geom,-80,37,-70,45)"},
        {"label": "INTERSECTS large (NE-US polygon)",                    "cql": "INTERSECTS(geom, ${NE_US})"},
        {"label": "INTERSECTS small (2°×2° DC box)",                     "cql": "INTERSECTS(geom, ${SMALL_BOX})"},
        {"label": "WITHIN large (NE-US)",                                "cql": "WITHIN(geom, ${NE_US})"},
        {"label": "DURING 2023",                                         "cql": "dtg DURING 2023-01-01T00:00:00Z/2024-01-01T00:00:00Z"},
        {"label": "INTERSECTS small AND DURING 2023",                    "cql": "INTERSECTS(geom, ${SMALL_BOX}) AND dtg DURING 2023-01-01T00:00:00Z/2024-01-01T00:00:00Z"},
        {"label": "category='urban' AND INTERSECTS large",               "cql": "category = 'urban' AND INTERSECTS(geom, ${NE_US})"},
        {"label": "[smoke] read INTERSECTS small as features",           "cql": "INTERSECTS(geom, ${SMALL_BOX})", "featuresOnly": true}
      ]
    },

    {
      "table": "tdrive",
      "label": "T-Drive Beijing taxi tracks",
      "filters": [
        {"label": "Unfiltered",                                          "cql": "INCLUDE"},
        {"label": "BBOX (~2km Forbidden City)",                          "cql": "BBOX(geom,116.39,39.91,116.41,39.93)"},
        {"label": "INTERSECTS large (inner Beijing, ~85%)",              "cql": "INTERSECTS(geom, ${BJ_LARGE})"},
        {"label": "INTERSECTS tight (~2km Forbidden City)",              "cql": "INTERSECTS(geom, ${BJ_TIGHT})"},
        {"label": "INTERSECTS PEK airport (~3km, suburb)",               "cql": "INTERSECTS(geom, ${BJ_PEK})"},
        {"label": "DWITHIN 1 km Tiananmen",                              "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters)"},
        {"label": "DWITHIN 5 km Tiananmen",                              "cql": "DWITHIN(geom, ${TIANANMEN}, 5000, meters)"},
        {"label": "DURING 2008-02-02 (single day, no spatial)",          "cql": "dtg DURING 2008-02-02T00:00:00Z/2008-02-03T00:00:00Z"},
        {"label": "DWITHIN 1km Tiananmen AND DURING 2008-02-02",         "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters) AND dtg DURING 2008-02-02T00:00:00Z/2008-02-03T00:00:00Z"},
        {"label": "[smoke] read DWITHIN 1km as features",                "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters)", "featuresOnly": true}
      ]
    },

    {
      "table": "tdrive2",
      "label": "T-Drive Beijing taxi tracks",
      "filters": [
        {"label": "Unfiltered",                                          "cql": "INCLUDE"},
        {"label": "BBOX (~2km Forbidden City)",                          "cql": "BBOX(geom,116.39,39.91,116.41,39.93)"},
        {"label": "INTERSECTS large (inner Beijing, ~85%)",              "cql": "INTERSECTS(geom, ${BJ_LARGE})"},
        {"label": "INTERSECTS tight (~2km Forbidden City)",              "cql": "INTERSECTS(geom, ${BJ_TIGHT})"},
        {"label": "INTERSECTS PEK airport (~3km, suburb)",               "cql": "INTERSECTS(geom, ${BJ_PEK})"},
        {"label": "DWITHIN 1 km Tiananmen",                              "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters)"},
        {"label": "DWITHIN 5 km Tiananmen",                              "cql": "DWITHIN(geom, ${TIANANMEN}, 5000, meters)"},
        {"label": "DURING 2008-02-02 (single day, no spatial)",          "cql": "dtg DURING 2008-02-02T00:00:00Z/2008-02-03T00:00:00Z"},
        {"label": "DWITHIN 1km Tiananmen AND DURING 2008-02-02",         "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters) AND dtg DURING 2008-02-02T00:00:00Z/2008-02-03T00:00:00Z"},
        {"label": "[smoke] read DWITHIN 1km as features",                "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters)", "featuresOnly": true}
      ]
    },

    {
      "table": "geolife",
      "label": "GeoLife GPS trajectories",
      "filters": [
        {"label": "Unfiltered",                                          "cql": "INCLUDE"},
        {"label": "BBOX (~2km Forbidden City)",                          "cql": "BBOX(geom,116.39,39.91,116.41,39.93)"},
        {"label": "INTERSECTS large (greater Beijing, ~80%)",            "cql": "INTERSECTS(geom, ${GL_LARGE})"},
        {"label": "INTERSECTS medium (~9km central, ~5%)",               "cql": "INTERSECTS(geom, ${GL_MEDIUM})"},
        {"label": "INTERSECTS tight (~2km Forbidden City)",              "cql": "INTERSECTS(geom, ${BJ_TIGHT})"},
        {"label": "INTERSECTS PEK airport (~3km, suburb)",               "cql": "INTERSECTS(geom, ${BJ_PEK})"},
        {"label": "WITHIN tight (~2km Forbidden City)",                  "cql": "WITHIN(geom, ${BJ_TIGHT})"},
        {"label": "DWITHIN 1 km Tiananmen",                              "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters)"},
        {"label": "DWITHIN 5 km Tiananmen",                              "cql": "DWITHIN(geom, ${TIANANMEN}, 5000, meters)"},
        {"label": "DURING 2008-02-02 (single day, no spatial)",          "cql": "dtg DURING 2008-02-02T00:00:00Z/2008-02-03T00:00:00Z"},
        {"label": "INTERSECTS tight AND DURING 2008-02-02",              "cql": "INTERSECTS(geom, ${BJ_TIGHT}) AND dtg DURING 2008-02-02T00:00:00Z/2008-02-03T00:00:00Z"},
        {"label": "[smoke] read DWITHIN 1km as features",                "cql": "DWITHIN(geom, ${TIANANMEN}, 1000, meters)", "featuresOnly": true}
      ]
    },

    {
      "table": "ais",
      "label": "Marine AIS vessel tracks",
      "filters": [
        {"label": "Unfiltered",                                          "cql": "INCLUDE"},
        {"label": "BBOX (~2km Port Everglades)",                         "cql": "BBOX(geom,-80.12,26.09,-80.10,26.11)"},
        {"label": "INTERSECTS large (FL+SE coast, ~80%)",                "cql": "INTERSECTS(geom, ${AIS_LARGE})"},
        {"label": "INTERSECTS medium (Charleston Harbor, ~5%)",          "cql": "INTERSECTS(geom, ${AIS_MEDIUM})"},
        {"label": "INTERSECTS tight (~2km Port Everglades)",             "cql": "INTERSECTS(geom, ${AIS_PE_TIGHT})"},
        {"label": "INTERSECTS Port Miami (~3km, different Z2)",          "cql": "INTERSECTS(geom, ${AIS_MIAMI})"},
        {"label": "WITHIN tight (~2km Port Everglades)",                 "cql": "WITHIN(geom, ${AIS_PE_TIGHT})"},
        {"label": "DWITHIN 1 km Port Everglades",                        "cql": "DWITHIN(geom, ${PORT_EVERGLADES}, 1000, meters)"},
        {"label": "DWITHIN 5 km Port Everglades",                        "cql": "DWITHIN(geom, ${PORT_EVERGLADES}, 5000, meters)"},
        {"label": "DURING Jan 1-15 2017",                                "cql": "dtg DURING 2017-01-01T00:00:00Z/2017-01-15T00:00:00Z"},
        {"label": "INTERSECTS tight AND DURING Jan 1-15 2017",           "cql": "INTERSECTS(geom, ${AIS_PE_TIGHT}) AND dtg DURING 2017-01-01T00:00:00Z/2017-01-15T00:00:00Z"},
        {"label": "vessel_type > 0 AND INTERSECTS tight",                "cql": "vessel_type > 0 AND INTERSECTS(geom, ${AIS_PE_TIGHT})"},
        {"label": "[smoke] read DWITHIN 1km as features",                "cql": "DWITHIN(geom, ${PORT_EVERGLADES}, 1000, meters)", "featuresOnly": true}
      ]
    },

    {
      "table": "observations_2geom",
      "label": "Synthetic CONUS multi-geom (center+Z2, ellipse+XZ2)",
      "filters": [
        {"label": "Unfiltered",                                                            "cql": "INCLUDE"},
        {"label": "BBOX center (NE-US)",                                                   "cql": "BBOX(\"center\",-80,37,-70,45)"},
        {"label": "BBOX ellipse (NE-US)",                                                  "cql": "BBOX(\"ellipse\",-80,37,-70,45)"},
        {"label": "INTERSECTS center NE-US AND INTERSECTS ellipse NE-US",                  "cql": "INTERSECTS(\"center\", ${NE_US}) AND INTERSECTS(\"ellipse\", ${NE_US})"},
        {"label": "INTERSECTS center NE-US AND INTERSECTS ellipse small",                  "cql": "INTERSECTS(\"center\", ${NE_US}) AND INTERSECTS(\"ellipse\", ${SMALL_BOX})"},
        {"label": "[smoke] read NE-US AND NE-US as features",                              "cql": "INTERSECTS(\"center\", ${NE_US}) AND INTERSECTS(\"ellipse\", ${NE_US})", "featuresOnly": true}
      ]
    },

    {
      "_comment": "FAA NextGen aircraft observations, table rawob_harrisnextgen. Lives in schema 'trino_test' (the 'schema' field below overrides the run's --schema default). Skipped on stacks that don't have the table — same auto-skip path as every other dataset above.",
      "table": "rawob_harrisnextgen",
      "schema": "trino_test",
      "label": "FAA NextGen aircraft observations",
      "filters": [
        {"label": "Unfiltered",       "cql": "INCLUDE"},
        {"label": "BBOX Atlanta 1°",  "cql": "BBOX(geom,-84.93,33.14,-83.93,34.14)"},
        {"label": "BBOX Texas",       "cql": "BBOX(geom,-107.0,25.0,-93.0,37.0)"},
        {"label": "BBOX CONUS",       "cql": "BBOX(geom,-125.0,24.0,-66.0,50.0)"}
      ]
    },

    {
      "_comment": "FAA NextGen aircraft observations (repartitioned v2), table rawob_harrisnextgen_v2. Lives in schema 'trino_test' (the 'schema' field below overrides the run's --schema default). Skipped on stacks that don't have the table — same auto-skip path as every other dataset above.",
      "table": "rawob_harrisnextgen_v2",
      "schema": "trino_test",
      "label": "FAA NextGen aircraft observations (v2)",
      "filters": [
        {"label": "Unfiltered",       "cql": "INCLUDE"},
        {"label": "BBOX Atlanta 1°",  "cql": "BBOX(geom,-84.93,33.14,-83.93,34.14)"},
        {"label": "BBOX Texas",       "cql": "BBOX(geom,-107.0,25.0,-93.0,37.0)"},
        {"label": "BBOX CONUS",       "cql": "BBOX(geom,-125.0,24.0,-66.0,50.0)"}
      ]
    }

  ]
}
