-server
# (2G/6G) Sized for barebones local dev VM, increase as desired
-Xms2G
-Xmx6G
#-XX:InitialRAMPercentage=40
#-XX:MaxRAMPercentage=70
#-XX:G1HeapRegionSize=32M
# Return committed heap to the OS during idle periods. G1 normally only shrinks
# heap during full GC; G1PeriodicGCInterval triggers a concurrent collection
# every 5 min when idle. Min/MaxHeapFreeRatio together tell the JVM to release
# committed memory once free heap exceeds Max=30% and not re-expand until free
# drops below Min=10% — JVM requires Min <= Max (default Min=40 violates that
# when Max=30 alone is set). Together: footprint ratchets down between query
# bursts instead of parking at Xmx until restart.
#-XX:G1PeriodicGCInterval=300000
#-XX:MinHeapFreeRatio=10
#-XX:MaxHeapFreeRatio=30
#-XX:+ExplicitGCInvokesConcurrent
#-XX:+HeapDumpOnOutOfMemoryError
#-XX:+UseGCOverheadLimit
#-XX:+ExitOnOutOfMemoryError
#-XX:ReservedCodeCacheSize=512M
#-Djdk.attach.allowAttachSelf=true
#-Dfile.encoding=UTF-8
#-XX:+UnlockDiagnosticVMOptions
#-XX:G1NumCollectionsKeepPinned=10000000
